# TMDB API Read Access Token (server-side only): https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=
# Optional fallback: TMDB v3 API key (also kept server-side)
TMDB_API_KEY=
# Optional persistent SQLite location. Set a durable volume path in production.
DATABASE_PATH=./cineverse.sqlite
# Optional; existing Gemini recommendation endpoints use this if configured.
GEMINI_API_KEY=
